<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flight Bridge" Width="1120" Height="840" MinWidth="880" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F5F6F8" FontFamily="Segoe UI" Foreground="#202C3B">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#E9EDF3"/><Setter Property="Foreground" Value="#243750"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#356CE6"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="BorderBrush" Value="#E4E8EF"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Window.Resources>
 <Grid Background="#F5F6F8"><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#EDF0F5" BorderBrush="#DDE2EB" BorderThickness="0,0,1,0" Padding="22,30"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><Border Background="#356CE6" CornerRadius="13" Width="48" Height="48" HorizontalAlignment="Left"><TextBlock Text="↗" FontSize="34" Foreground="White" HorizontalAlignment="Center"/></Border><TextBlock Text="Flight Bridge" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock Text="Ваше управление.&#10;Новый симулятор." Foreground="#748092" FontSize="12"/>
   <Border Background="#DDE6F8" CornerRadius="8" Padding="13" Margin="-5,38,-5,12"><TextBlock Text="↗   Перенос профиля" Foreground="#285FCB" FontWeight="SemiBold"/></Border>
   <Button Name="Restore" Content="↶  Восстановление" Background="Transparent" Padding="7,12" HorizontalAlignment="Left" FontSize="13"/>
   <Button Name="ShowQueue" Content="≡   Список переноса · 0" Background="Transparent" Padding="7,12" HorizontalAlignment="Left" FontSize="13"/>
   <Button Name="Help" Content="?   Как это работает" Background="Transparent" Padding="7,12" HorizontalAlignment="Left" FontSize="13"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="ЛОКАЛЬНО И БЕЗ ОБЛАКА" FontSize="9" FontWeight="SemiBold" Foreground="#7B8899"/><TextBlock Text="Исходные настройки&#10;остаются у вас." FontSize="12" Foreground="#7B8899" Margin="0,8,0,16"/><TextBlock Text="Версия 0.3 · предварительная" FontSize="10" Foreground="#939CAB"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="32,26,32,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="MSFS 2020   →   MSFS 2024" Foreground="#356CE6" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Знакомое управление.&#10;Готово к новому полёту." FontSize="30" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock Text="Выберите профили. Проверьте перенос. Импортируйте результат в игре." Foreground="#788496" FontSize="13" Margin="0,0,0,20"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="01   Откуда переносим" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Профили джойстиков, педалей и РУД из MSFS 2020" Foreground="#788496" Margin="0,5,0,12"/><ComboBox Name="Sources" Height="34" FontSize="13"/><TextBlock Name="SourcePath" FontSize="10" Foreground="#8993A3" Margin="0,6,0,12"/><WrapPanel><Button Name="Scan" Content="Найти автоматически"/><Button Name="BrowseSource" Content="Файлы…"/><Button Name="SourceFolder" Content="Папка…"/></WrapPanel></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="02   Профиль нового симулятора" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="В MSFS 2024: Управление → устройство → шестерёнка категории → Экспорт. Можно выбрать несколько файлов." Foreground="#788496" Margin="0,5,0,12"/><ComboBox Name="Targets" Height="34" FontSize="13"/><DockPanel Margin="0,10,0,0"><Button Name="BrowseTarget" Content="Выбрать файлы…" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Name="TargetName" Text="Файл ещё не выбран" VerticalAlignment="Center" FontSize="12" Foreground="#788496"/></DockPanel><CheckBox Name="Relocated" IsChecked="True" Content="Находить команды, перемещённые в другой контекст" Margin="0,14,0,0" FontSize="12" ToolTip="Только однозначное совпадение идентификатора команды. Перемещения будут перечислены в отчёте для проверки."/></StackPanel></Border>
    <Border Background="#EAF1ED" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><CheckBox Name="Backup" IsChecked="True" Content="Сохранить резервную копию" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Оба исходных профиля сохранятся рядом с результатом. Возврат доступен в разделе «Восстановление»." Margin="22,6,0,0" Foreground="#607669" FontSize="12"/></StackPanel></Border>
    <Border Name="ReportCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,12"><StackPanel><TextBox Name="Report" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="180" VerticalScrollBarVisibility="Auto"/><Button Name="AddQueue" Content="+ Добавить в список переноса" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Name="Status" Text="Начните с поиска или выбора профиля 2020." Foreground="#69788B" FontSize="12" Margin="0,0,0,12"/><DockPanel><Button Name="Export" Content="Сохранить для MSFS 2024  →" Background="#356CE6" Foreground="White" IsEnabled="False" DockPanel.Dock="Right" Margin="10,0,0,0"/><Button Name="Analyze" Content="Проверить перенос" IsEnabled="False" HorizontalAlignment="Left"/></DockPanel></StackPanel>
  </Grid>
 </Grid>
</Window>
